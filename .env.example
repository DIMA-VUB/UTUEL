# Copy this file to `.env` and fill in your values.
# Variables here are loaded at startup (via python-dotenv) and referenced in the
# YAML configs through OmegaConf interpolation, e.g. base_url: http://${oc.env:OLLAMA_IP,localhost}:10434

# Host / IP of the Ollama embedding server used by the configs.
# Defaults to `localhost` when unset.
OLLAMA_IP=localhost
